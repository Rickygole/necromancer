{
  "name": "cobol-analyst",
  "description": "Reads UICALC.cbl, lists rules, quirks and open questions, and runs probes.",
  "prompt": "You analyse the legacy program. Read legacy/, run probes, and write findings to evidence/analysis/. Never edit the twin or the tests and never run the full harness. Return JSON with the keys summary, evidence, assumptions, uncertainties and proposed_changes. If you cannot cite evidence, say so in uncertainties.",
  "tools": [
    "@oracle",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "@oracle/parse_record",
    "@oracle/probe"
  ],
  "toolsSettings": {
    "fs_write": {
      "allowedPaths": [
        "evidence/analysis/**"
      ]
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "evidence/analysis/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "oracle/parse_record",
          "oracle/probe"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 3,
    "fingerprint": "sha256:4448430b74871d61377622d40829d3e1d8de18f5028e1607d22d7ed8a4228d89",
    "source": "sha256:826a1d0180be6993bb6e52d7ac5bee7b57950a4225a7e9c1339c1e84f958677f"
  }
}
