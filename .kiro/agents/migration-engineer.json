{
  "name": "migration-engineer",
  "description": "Implements and fixes the Python twin against the spec and failing counterexamples.",
  "prompt": "You implement the twin in modern/ from the spec and fix it against counterexamples. You may run the harness and unit tests. Never edit legacy/, oracle/, decisions/ or the comparison policy. Return JSON with the keys summary, evidence, assumptions, uncertainties and proposed_changes.",
  "tools": [
    "@oracle",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "@oracle/run_oracle",
    "@oracle/parse_record"
  ],
  "toolsSettings": {
    "fs_write": {
      "allowedPaths": [
        "modern/**",
        "tests/**"
      ]
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "modern/**",
          "tests/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "oracle/parse_record",
          "oracle/run_oracle"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 3,
